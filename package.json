{
    "name": "flix-monkey",
    "displayName": "FlixMonkey",
    "version": "1.7.0",
    "description": "See IMDb, Metacritic, and Rotten Tomatoes ratings while browsing Netflix, HBO Max, and Disney+.",
    "license": "GPL-3.0-only",
    "author": "fran",
    "homepage": "https://github.com/fran2889/flix-monkey",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fran2889/flix-monkey.git"
    },
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write \"{src,tests,scripts}/**/*.{js,ts}\" \"*.{config.js,json,md}\" \"src/**/*.{html,json}\" \".github/**/*.md\"",
        "format:check": "prettier --check \"{src,tests,scripts}/**/*.{js,ts}\" \"*.{config.js,json,md}\" \"src/**/*.{html,json}\" \".github/**/*.md\"",
        "lint": "eslint --max-warnings=0 \"{src,tests,scripts}/**/*.{js,ts}\" \"*.config.js\"",
        "lint:fix": "eslint --fix --max-warnings=0 \"{src,tests,scripts}/**/*.{js,ts}\" \"*.config.js\"",
        "type-check": "tsc --noEmit",
        "clean": "npx rimraf dist coverage",
        "prebuild": "npm run clean",
        "build:userscript": "rollup -c --environment TARGET:userscript",
        "build:firefox": "rollup -c --environment TARGET:firefox && node scripts/package.js",
        "build:chrome": "rollup -c --environment TARGET:chrome && node scripts/package.js",
        "build": "rollup -c && node scripts/package.js",
        "package:source": "git archive --format=zip --output dist/FlixMonkey-v$npm_package_version-source.zip HEAD",
        "dev": "rollup -cw",
        "test": "vitest run tests/unit tests/ui",
        "test:unit": "vitest run tests/unit",
        "test:ui": "vitest run tests/ui",
        "test:integration": "vitest run -c vitest.integration.config.js",
        "test:coverage": "vitest run tests/unit tests/ui --coverage",
        "audit": "npm audit --audit-level=moderate",
        "audit:fix": "npm audit fix --force-will-break-dependencies=false"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.0.2",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/node": "^26.6.5",
        "@types/webextension-polyfill": "^0.12.6",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@violentmonkey/types": "^0.3.4",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitest/coverage-v8": "^5.0.4",
        "archiver": "^8.0.0",
        "chrome-webstore-upload-cli": "^4.0.2",
        "dotenv": "^18.0.7",
        "eslint": "^10.11.0",
        "eslint-plugin-headers": "^1.3.4",
        "eslint-plugin-jsdoc": "^65.0.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "rollup": "^4.64.6",
        "rollup-plugin-esbuild": "^6.2.1",
        "sharp": "^0.35.5",
        "tslib": "^2.6.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0",
        "webextension-polyfill": "^0.12.0"
    },
    "engines": {
        "node": ">= 24"
    },
    "lint-staged": {
        "{src,tests,scripts}/**/*.{js,ts}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.config.js": [
            "prettier --write",
            "eslint --fix"
        ],
        "**/*.{json,md}": [
            "prettier --write"
        ],
        "src/**/*.{html,json}": [
            "prettier --write"
        ]
    }
}
