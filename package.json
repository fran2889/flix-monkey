{
    "name": "flix-monkey",
    "displayName": "FlixMonkey",
    "version": "1.7.0",
    "description": "See IMDb, Metacritic, and Rotten Tomatoes ratings while browsing Netflix, HBO Max, and Disney+.",
    "author": "fran",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/fran2889/flix-monkey",
    "type": "module",
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write \"{src,tests,scripts}/**/*.js\" \"*.config.js\" \"src/**/*.html\" \"*.{json,md,yml,html}\"",
        "format:check": "prettier --check \"{src,tests,scripts}/**/*.js\" \"*.config.js\" \"src/**/*.html\" \"*.{json,md,yml,html}\"",
        "lint": "eslint \"{src,tests}/**/*.js\" \"scripts/**/*.js\" \"*.config.js\"",
        "lint:fix": "eslint --fix \"{src,tests}/**/*.js\" \"scripts/**/*.js\" \"*.config.js\"",
        "build:userscript": "rollup -c --environment TARGET:userscript",
        "build:firefox": "rollup -c --environment TARGET:firefox && node scripts/package.js",
        "build:chrome": "rollup -c --environment TARGET:chrome && node scripts/package.js",
        "build": "rollup -c && node scripts/package.js",
        "package:source": "git archive --format=zip --output dist/FlixMonkey-v$npm_package_version-source.zip HEAD",
        "dev": "rollup -cw",
        "test": "vitest run tests/unit tests/ui",
        "test:coverage": "vitest run tests/unit tests/ui --coverage",
        "test:unit": "vitest run tests/unit",
        "test:ui": "vitest run tests/ui",
        "test:integration": "vitest run -c vitest.integration.config.js",
        "audit": "npm audit --omit=dev --audit-level=high",
        "clean": "npx rimraf dist coverage"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.0.2",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@vitest/coverage-v8": "^5.0.2",
        "archiver": "^8.0.0",
        "chrome-webstore-upload-cli": "^4.0.1",
        "dotenv": "^17.4.2",
        "eslint": "^10.11.0",
        "eslint-plugin-headers": "^1.3.4",
        "eslint-plugin-jsdoc": "^64.5.4",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.9",
        "rollup": "^4.63.5",
        "sharp": "^0.35.5",
        "vitest": "^5.0.0",
        "web-ext": "^10.7.0",
        "webextension-polyfill": "^0.12.0"
    },
    "engines": {
        "node": ">= 24"
    },
    "sideEffects": false,
    "lint-staged": {
        "{src,tests,scripts}/**/*.js": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.config.js": [
            "prettier --write",
            "eslint --fix"
        ],
        "src/**/*.html": [
            "prettier --write"
        ],
        "*.{json,md,yml,html}": [
            "prettier --write"
        ]
    }
}
